{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": [
    "dist",
    "storybook-static",
    "src/routeTree.gen.ts"
  ]
}
